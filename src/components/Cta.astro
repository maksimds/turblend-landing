---
// A text link with the arrow after it: "Get on the list ->". Any other attribute
// (data-share, ...) is passed on to the link.
import type { HTMLAttributes } from "astro/types";
import Arrow from "./Arrow.astro";

type Props = HTMLAttributes<"a"> & { label: string };
const { label, class: className, ...attrs } = Astro.props;
---
<a class:list={["cta", className]} {...attrs}><span>{label}</span><Arrow /></a>
