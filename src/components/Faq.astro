<section id="faq" class="strate container" aria-labelledby="faq-title">
  <div class="grid ruled">
    <div class="faq-head rv-up">
      <p class="mini">Chapter 07 · FAQ</p>
      <h2 id="faq-title" class="title-page">Questions, <em>answered.</em></h2>
    </div>

    <div class="faq-list rv-up" data-d="1">
      <details class="faq-item">
        <summary><span>What is Turkish coffee?</span><span class="faq-icon" aria-hidden="true"></span></summary>
        <div class="faq-answer"><p>Finely ground coffee simmered unfiltered in a cezve and served with its grounds, which settle to the bottom of the cup.</p></div>
      </details>
      <details class="faq-item">
        <summary><span>Why brew on sand?</span><span class="faq-icon" aria-hidden="true"></span></summary>
        <div class="faq-answer"><p>Hot sand heats the cezve slowly and evenly, building a thick foam before the coffee boils.</p></div>
      </details>
      <details class="faq-item">
        <summary><span>Can I buy beans?</span><span class="faq-icon" aria-hidden="true"></span></summary>
        <div class="faq-answer"><p>Soon. Bags are coming first to list members.</p></div>
      </details>
      <details class="faq-item">
        <summary><span>Do you cater events?</span><span class="faq-icon" aria-hidden="true"></span></summary>
        <div class="faq-answer"><p>Yes. Reach out for private tastings and partnerships.</p></div>
      </details>
    </div>
  </div>
</section>

<script>
  import { $, $$, reduceMotion } from "../scripts/dom";

  // Answers unfold and fold instead of snapping open. A second click mid-way
  // reverses from wherever the answer is. Without this, <details> still works.
  if (!reduceMotion && typeof Element.prototype.animate === "function") {
    $$<HTMLDetailsElement>(".faq-item").forEach((item) => {
      const summary = $("summary", item);
      if (!summary) return;
      let running: Animation | null = null;

      summary.addEventListener("click", (event) => {
        event.preventDefault();
        const from = item.offsetHeight;
        const closing = item.open && item.dataset.state !== "closing";
        if (running) running.cancel();

        let to: number;
        if (closing) {
          item.dataset.state = "closing";
          to = summary.offsetHeight + (item.offsetHeight - item.clientHeight);
        } else {
          item.dataset.state = "opening";
          item.open = true;
          to = item.offsetHeight;
        }

        item.style.overflow = "hidden";
        const animation = item.animate(
          { height: [from + "px", to + "px"] },
          { duration: 350, easing: "cubic-bezier(0.16, 1, 0.3, 1)" },
        );
        running = animation;
        animation.onfinish = () => {
          running = null;
          if (closing) item.open = false;
          delete item.dataset.state;
          item.style.overflow = "";
        };
      });
    });
  }
</script>
