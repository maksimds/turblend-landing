---
import { getImage } from "astro:assets";
import { photos } from "../photos";
import Cta from "./Cta.astro";

// Phones get hero-mobile, a 2:3 crop; wider screens the 16:9 photo, in two sizes.
const phone = await getImage({ src: photos.heroMobile, format: "avif" });
const phoneJpg = await getImage({ src: photos.heroMobile, format: "jpg" });
const wide = await getImage({ src: photos.hero, format: "avif", widths: [1200, 2000] });
const wideJpg = await getImage({ src: photos.hero, format: "jpg", widths: [1200, 2000] });
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-banner">
    <!-- HERO PHOTO: Unsplash stock (unsplash.com/photos/AgPj0maIEEs), until we shoot our own.
         16:9 on desktop; phones get hero-mobile, a 2:3 crop of the same photo.
         Keep the subject away from the bottom-left corner, where the headline sits.
         Every photo is one full-size original in src/assets/photos/ (see src/photos.ts);
         the build makes the AVIF sizes and the JPG for older browsers. -->
    <figure class="hero-media">
      <picture>
        <source media="(max-width: 767px)" srcset={phone.src} type="image/avif">
        <source media="(max-width: 767px)" srcset={phoneJpg.src}>
        <source srcset={wide.srcSet.attribute} sizes="100vw" type="image/avif">
        <img src={wideJpg.src} srcset={wideJpg.srcSet.attribute} sizes="100vw" alt="A green mountain valley with rows of coffee on the hillsides" fetchpriority="high">
      </picture>
    </figure>
    <div class="hero-content container dark">
      <div class="hero-text rv-up">
        <p class="mini hero-sup">Welcome to Turblend · Cincinnati</p>
        <h1 id="hero-title" class="title-page hero-title">Brewed on <em>sand.</em> Grown in the <em>sun.</em></h1>
      </div>
    </div>
  </div>

  <div class="intro strate container">
    <div class="grid">
      <figure class="fig intro-fig rv">
        <div class="fig-art">
          <svg class="drawing" viewBox="0 0 100 125" aria-hidden="true">
            <path d="M45 37c-3-4 3-7 0-11s3-7 0-11M53 38c-3-4 3-7 0-11s3-7 0-10"/>
            <path d="M33 46c5-3 25-3 30 0M33 46c5 3 25 3 30 0M33 46c-2.2-.6-3.8-1.3-5.2-2.6 2.2.3 4 .7 5.4 1.5"/>
            <path d="M37.5 45.4c1.4-2.6 4.2-2.6 5.6 0M43.1 45c1.5-2.8 4.4-2.8 5.9 0M49 45c1.5-2.8 4.4-2.8 5.9 0M54.9 45.4c1.4-2.4 4-2.4 5.3 0"/>
            <path d="M34.8 47.6c1.8 2.4 2.8 5 3 7.8-6.2 6.6-9.2 16.6-8.2 33.6M61.2 47.6c-1.8 2.4-2.8 5-3 7.8 6.2 6.6 9.2 16.6 8.2 33.6M37.8 55.4c6.2 1.6 14.2 1.6 20.4 0"/>
            <path d="M58.6 53 91 31.5M59.8 57.4 92.6 35.6M91 31.5c1.6-.6 2.6.6 1.6 4.1"/>
            <path d="M29.6 89c10.4 3.6 26.4 3.6 36.8 0M4 92c9-3.4 18-4 25.6-3M66.4 89c8.6-1 19.6-.4 29.6 3M8 101c9-2.6 19-2.8 28-.6s19 2.4 28 .2 19-2.4 28-.4M14 110c8-2 16-2.2 24-.4s16 2 24 .2 16-1.8 24-.2"/>
            <circle class="grain" cx="20" cy="96" r=".7"/><circle class="grain" cx="34" cy="97" r=".7"/><circle class="grain" cx="47" cy="96.5" r=".7"/><circle class="grain" cx="61" cy="97.5" r=".7"/><circle class="grain" cx="76" cy="95.5" r=".7"/><circle class="grain" cx="88" cy="97" r=".7"/><circle class="grain" cx="26" cy="105" r=".7"/><circle class="grain" cx="52" cy="105.5" r=".7"/><circle class="grain" cx="70" cy="104.5" r=".7"/><circle class="grain" cx="40" cy="114" r=".7"/><circle class="grain" cx="62" cy="114.6" r=".7"/><circle class="grain" cx="82" cy="112" r=".7"/>
          </svg>
        </div>
        <figcaption class="fig-cap mini">Fig. 1<br>Cezve in hot sand</figcaption>
      </figure>

      <div class="intro-text rv-up" data-d="1">
        <p class="mini">Single origin · Fresh roasted · Brewed on sand</p>
        <p class="title-small">Single-origin Puerto Rican beans, roasted fresh in small batches and prepared in the Turkish tradition: slow, fragrant, and brewed over hot sand. A 500-year-old ritual, returned to its freshest form.</p>
        <div class="cta-row">
          <Cta href="#signup" label="Get on the list" />
          <Cta href="#popups" label="Find a pop-up" />
        </div>
        <!-- The date and venue fill in automatically from src/data/events.ts -->
        <p class="mini intro-next">
          <span class="dot pulse" aria-hidden="true"></span>
          <a href="#popups">Next pop-up · Cincinnati · <strong data-next-popup data-fallback="Dates soon">Dates soon</strong></a>
        </p>
      </div>
    </div>
  </div>
</section>
