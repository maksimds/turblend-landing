---
// The document shell every page shares: <head> basics and the stylesheet. Pages
// add their own tags to <head> through the "meta" slot (right after the title)
// and the "head" slot (after the icons). Each component brings its own script.
import "../styles/global.css";
import { asset } from "../site";

interface Props {
  title: string;
  /** A <base> address for every relative link and path on the page (the 404 page). */
  baseHref?: string;
}
const { title, baseHref } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {baseHref && <base href={baseHref}>}
  <title>{title}</title>
  <slot name="meta" />
  <meta name="theme-color" content="#f7f2ea">
  <link rel="icon" href={asset("favicon.ico")} sizes="32x32">
  <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml">
  <link rel="apple-touch-icon" href={asset("apple-touch-icon.png")}>
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
